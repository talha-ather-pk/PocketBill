<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions are requested. Add one only with a documented reason (task P4-T14). -->

    <!-- allowBackup stays off: invoice data must never be copied to Google's servers (DECISIONS D-009). -->
    <application
        android:name=".app.PocketBillApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketBill">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PocketBill">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
