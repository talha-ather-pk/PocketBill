<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (D-019). Cloud backup: nothing, so invoice data never goes to Google's servers (D-009).
     Device-to-device transfer (setting up a new phone from the old one): everything, so invoices move with the user. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" />
        <include domain="sharedpref" />
        <include domain="file" />
    </device-transfer>
</data-extraction-rules>
